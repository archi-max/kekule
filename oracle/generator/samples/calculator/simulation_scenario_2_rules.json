    {
      "id": "temp_celsius_to_fahrenheit_correct",
      "description": "TemperatureConverter.celsius_to_fahrenheit must return correct conversion using formula (celsius * 9/5) + 32",
      "oracle_type": "pytest",
      "oracle_config": {
        "target_module": "src/calculator/converter.py",
        "class": "TemperatureConverter",
        "method": "celsius_to_fahrenheit",
        "test_cases": [
          {
            "input": {
              "celsius": 0
            },
            "expected": 32.0
          },
          {
            "input": {
              "celsius": 100
            },
            "expected": 212.0
          },
          {
            "input": {
              "celsius": -40
            },
            "expected": -40.0
          },
          {
            "input": {
              "celsius": 37
            },
            "expected": 98.6
          },
          {
            "input": {
              "celsius": 25
            },
            "expected": 77.0
          }
        ]
      },
      "uncertainty": 0.0,
      "status": "confirmed"
    },
    {
      "id": "temp_fahrenheit_to_celsius_correct",
      "description": "TemperatureConverter.fahrenheit_to_celsius must return correct conversion using formula (fahrenheit - 32) * 5/9",
      "oracle_type": "pytest",
      "oracle_config": {
        "target_module": "src/calculator/converter.py",
        "class": "TemperatureConverter",
        "method": "fahrenheit_to_celsius",
        "test_cases": [
          {
            "input": {
              "fahrenheit": 32
            },
            "expected": 0.0
          },
          {
            "input": {
              "fahrenheit": 212
            },
            "expected": 100.0
          },
          {
            "input": {
              "fahrenheit": -40
            },
            "expected": -40.0
          },
          {
            "input": {
              "fahrenheit": 98.6
            },
            "expected": 37.0
          },
          {
            "input": {
              "fahrenheit": 77
            },
            "expected": 25.0
          }
        ]
      },
      "uncertainty": 0.0,
      "status": "confirmed"
    },
    {
      "id": "temp_celsius_to_kelvin_correct",
      "description": "TemperatureConverter.celsius_to_kelvin must return correct conversion using formula celsius + 273.15 for valid temperatures",
      "oracle_type": "pytest",
      "oracle_config": {
        "target_module": "src/calculator/converter.py",
        "class": "TemperatureConverter",
        "method": "celsius_to_kelvin",
        "test_cases": [
          {
            "input": {
              "celsius": 0
            },
            "expected": 273.15
          },
          {
            "input": {
              "celsius": 100
            },
            "expected": 373.15
          },
          {
            "input": {
              "celsius": -273.15
            },
            "expected": 0.0
          },
          {
            "input": {
              "celsius": 25
            },
            "expected": 298.15
          }
        ]
      },
      "uncertainty": 0.0,
      "status": "confirmed"
    },
    {
      "id": "temp_celsius_to_kelvin_below_absolute_zero",
      "description": "TemperatureConverter.celsius_to_kelvin must raise ValueError with message 'Temperature {celsius}\u00b0C is below absolute zero' when celsius input would result in kelvin below 0",
      "oracle_type": "pytest",
      "oracle_config": {
        "target_module": "src/calculator/converter.py",
        "class": "TemperatureConverter",
        "method": "celsius_to_kelvin",
        "test_cases": [
          {
            "input": {
              "celsius": -300
            },
            "expected_exception": "ValueError",
            "expected_message": "Temperature -300\u00b0C is below absolute zero"
          },
          {
            "input": {
              "celsius": -274
            },
            "expected_exception": "ValueError",
            "expected_message": "Temperature -274\u00b0C is below absolute zero"
          }
        ]
      },
      "uncertainty": 0.0,
      "status": "confirmed"
    },
    {
      "id": "temp_kelvin_to_celsius_correct",
