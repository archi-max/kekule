          },
          {
            "input": {
              "kelvin": 0
            },
            "expected": -273.15
          },
          {
            "input": {
              "kelvin": 298.15
            },
            "expected": 25.0
          }
        ]
      },
      "uncertainty": 0.0,
      "status": "confirmed"
    },
    {
      "id": "temp_kelvin_to_celsius_negative_kelvin",
      "description": "TemperatureConverter.kelvin_to_celsius must raise ValueError when kelvin input is negative",
      "oracle_type": "pytest",
      "oracle_config": {
        "target_module": "src/calculator/converter.py",
        "class": "TemperatureConverter",
        "method": "kelvin_to_celsius",
        "test_cases": [
          {
            "input": {
              "kelvin": -10
            },
            "expected_exception": "ValueError"
          },
          {
            "input": {
              "kelvin": -1
            },
            "expected_exception": "ValueError"
          }
        ]
      },
      "uncertainty": 0.0,
      "status": "confirmed"
    },
    {
      "id": "temp_converter_roundtrip_preserves_values",
      "description": "Temperature conversions between celsius/fahrenheit and celsius/kelvin should preserve values within floating point precision when converted back. Test each conversion pair independently.",
      "oracle_type": "pytest",
      "oracle_config": {
        "target_module": "src/calculator/converter.py",
        "class": "TemperatureConverter",
        "test_cases": [
          {
            "input": {
              "celsius": 0
            },
            "method_sequence": [
              "celsius_to_fahrenheit",
              "fahrenheit_to_celsius"
            ],
            "tolerance": 1e-10
          },
          {
            "input": {
              "celsius": 100
            },
            "method_sequence": [
              "celsius_to_fahrenheit",
              "fahrenheit_to_celsius"
            ],
            "tolerance": 1e-10
          },
          {
            "input": {
              "celsius": 0
            },
            "method_sequence": [
              "celsius_to_kelvin",
              "kelvin_to_celsius"
            ],
            "tolerance": 1e-10
          },
          {
            "input": {
              "celsius": 100
            },
            "method_sequence": [
              "celsius_to_kelvin",
              "kelvin_to_celsius"
            ],
            "tolerance": 1e-10
          }
        ]
      },
      "uncertainty": 0.1,
      "status": "confirmed"
    },
    {
      "id": "length_convert_valid_units_correct",
      "description": "LengthConverter.convert must correctly convert between all supported units (meter, kilometer, centimeter, millimeter, mile, yard, foot, inch) using the METERS_PER_UNIT conversion factors",
      "oracle_type": "pytest",
      "oracle_config": {
        "target_module": "src/calculator/converter.py",
        "class": "LengthConverter",
        "method": "convert",
        "test_cases": [
          {
            "input": {
              "value": 1,
              "from_unit": "meter",
              "to_unit": "meter"
            },
            "expected": 1.0,
            "tolerance": 1e-10
          },
          {
            "input": {
              "value": 1,
              "from_unit": "kilometer",
              "to_unit": "meter"
            },
            "expected": 1000.0,
            "tolerance": 1e-10
          },
          {
            "input": {
              "value": 1,
              "from_unit": "meter",
              "to_unit": "centimeter"
            },
            "expected": 100.0,
            "tolerance": 1e-10
          },
          {
            "input": {
              "value": 1,
              "from_unit": "foot",
              "to_unit": "inch"
            },
            "expected": 12.0,
            "tolerance": 1e-10
          },
          {
            "input": {
              "value": 1,
              "from_unit": "mile",
              "to_unit": "kilometer"
            },
            "expected": 1.609344,
            "tolerance": 1e-10
          }
        ]
      },
      "uncertainty": 0.1,
      "status": "confirmed"
    },
    {
      "id": "length_convert_unknown_units_raises_error",
      "description": "LengthConverter.convert must raise ValueError with message 'Unknown unit: {unit_name}' when either from_unit or to_unit is not in the supported units list",
      "oracle_type": "pytest",
      "oracle_config": {
        "target_module": "src/calculator/converter.py",
        "class": "LengthConverter",
        "method": "convert",
        "test_cases": [
          {
            "input": {
              "value": 1,
              "from_unit": "furlong",
              "to_unit": "meter"
            },
            "expected_exception": "ValueError",
            "expected_message": "Unknown unit: furlong"
          },
          {
            "input": {
              "value": 1,
              "from_unit": "meter",
              "to_unit": "parsec"
            },
            "expected_exception": "ValueError",
            "expected_message": "Unknown unit: parsec"
          },
          {
            "input": {
              "value": 1,
              "from_unit": "unknown",
              "to_unit": "invalid"
            },
            "expected_exception": "ValueError",
            "expected_message": "Unknown unit: unknown"
          }
        ]
      },
      "uncertainty": 0.0,
      "status": "confirmed"
    },
    {
      "id": "calc_memory_store_recall_correct",
      "description": "Calculator.store must save a value to memory and Calculator.recall must return the stored value",
      "oracle_type": "pytest",
      "oracle_config": {
        "target_module": "src/calculator/core.py",
        "class": "Calculator",
        "method": "store",
        "test_cases": [
          {
            "input": {
              "value": 42
            },
            "verify_method": "recall",
            "expected": 42
          },
          {
            "input": {
              "value": -10.5
            },
            "verify_method": "recall",
            "expected": -10.5
          },
          {
            "input": {
              "value": 0
            },
            "verify_method": "recall",
            "expected": 0
          }
        ]
      },
      "uncertainty": 0.0,
      "status": "confirmed"
    },
    {
      "id": "calc_memory_clear_resets_to_zero",
      "description": "Calculator.clear_memory must reset memory to 0.0, verified by subsequent recall returning 0.0",
      "oracle_type": "pytest",
      "oracle_config": {
        "target_module": "src/calculator/core.py",
        "class": "Calculator",
        "method": "clear_memory",
        "test_cases": [
          {
            "setup": {
              "store": 100
            },
            "verify_method": "recall",
            "expected": 0.0
          }
        ]
      },
      "uncertainty": 0.0,
      "status": "confirmed"
    },
    {
      "id": "calc_history_records_operations",
      "description": "Calculator arithmetic operations (add, subtract, multiply, divide, power, modulo) must append formatted operation strings to history list accessible via get_history(). Each test case uses a fresh Calculator instance and verifies that the operation appears as the last entry in history.",
      "oracle_type": "pytest",
      "oracle_config": {
        "target_module": "src/calculator/core.py",
        "class": "Calculator",
        "test_cases": [
          {
            "operation": "add",
            "input": {
              "a": 2,
              "b": 3
            },
            "expected_history_last_entry": "2 + 3 = 5"
          },
          {
            "operation": "subtract",
            "input": {
              "a": 10,
              "b": 3
            },
            "expected_history_last_entry": "10 - 3 = 7"
          },
          {
            "operation": "multiply",
            "input": {
              "a": 4,
              "b": 5
            },
            "expected_history_last_entry": "4 * 5 = 20"
          },
          {
            "operation": "divide",
            "input": {
              "a": 10,
              "b": 2
            },
            "expected_history_last_entry": "10 / 2 = 5.0"
          },
          {
            "operation": "power",
            "input": {
              "base": 2,
              "exponent": 3
            },
            "expected_history_last_entry": "2 ^ 3 = 8"
          },
          {
            "operation": "modulo",
            "input": {
              "a": 10,
              "b": 3
            },
            "expected_history_last_entry": "10 % 3 = 1"
          }
        ]
      },
      "uncertainty": 0.1,
      "status": "confirmed"
    }
  ]
}