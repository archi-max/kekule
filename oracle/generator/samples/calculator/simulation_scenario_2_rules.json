{
  "rules": [
    {
      "id": "calc_add_correct_results",
      "description": "Calculator.add must return the mathematically correct sum of two numbers (a + b)",
      "oracle_type": "pytest",
      "oracle_config": {
        "target_module": "src/calculator/core.py",
        "class": "Calculator",
        "method": "add",
        "test_cases": [
          {
            "input": {
              "a": 2,
              "b": 3
            },
            "expected": 5
          },
          {
            "input": {
              "a": -5,
              "b": 10
            },
            "expected": 5
          },
          {
            "input": {
              "a": 0,
              "b": 0
            },
            "expected": 0
          },
          {
            "input": {
              "a": 1.5,
              "b": 2.5
            },
            "expected": 4.0
          },
          {
            "input": {
              "a": -10,
              "b": -20
            },
            "expected": -30
          }
        ]
      },
      "uncertainty": 0.0,
      "status": "confirmed"
    },
    {
      "id": "calc_subtract_correct_results",
      "description": "Calculator.subtract must return the mathematically correct difference (a - b)",
      "oracle_type": "pytest",
      "oracle_config": {
        "target_module": "src/calculator/core.py",
        "class": "Calculator",
        "method": "subtract",
        "test_cases": [
          {
            "input": {
              "a": 10,
              "b": 3
            },
            "expected": 7
          },
          {
            "input": {
              "a": 5,
              "b": 10
            },
            "expected": -5
          },
          {
            "input": {
              "a": 0,
              "b": 0
            },
            "expected": 0
          },
          {
            "input": {
              "a": 7.5,
              "b": 2.5
            },
            "expected": 5.0
          },
          {
            "input": {
              "a": -10,
              "b": -5
            },
            "expected": -5
          }
        ]
      },
      "uncertainty": 0.0,
      "status": "confirmed"
    },
