    {
      "id": "calc_divide_correct_results",
      "description": "Calculator.divide must return the mathematically correct quotient (a / b) for valid non-zero divisors",
      "oracle_type": "pytest",
      "oracle_config": {
        "target_module": "src/calculator/core.py",
        "class": "Calculator",
        "method": "divide",
        "test_cases": [
          {
            "input": {
              "a": 10,
              "b": 2
            },
            "expected": 5.0
          },
          {
            "input": {
              "a": 15,
              "b": 3
            },
            "expected": 5.0
          },
          {
            "input": {
              "a": 7,
              "b": 2
            },
            "expected": 3.5
          },
          {
            "input": {
              "a": -10,
              "b": 2
            },
            "expected": -5.0
          },
          {
            "input": {
              "a": 0,
              "b": 5
            },
            "expected": 0.0
          }
        ]
      },
      "uncertainty": 0.0,
      "status": "confirmed"
    },
    {
      "id": "calc_divide_by_zero_raises_error",
      "description": "Calculator.divide must raise ZeroDivisionError with message 'Cannot divide by zero' when b is 0",
      "oracle_type": "pytest",
      "oracle_config": {
        "target_module": "src/calculator/core.py",
        "class": "Calculator",
        "method": "divide",
        "test_cases": [
          {
            "input": {
              "a": 10,
              "b": 0
            },
            "expected_exception": "ZeroDivisionError",
            "expected_message": "Cannot divide by zero"
          },
          {
            "input": {
              "a": 0,
              "b": 0
            },
            "expected_exception": "ZeroDivisionError",
            "expected_message": "Cannot divide by zero"
          },
          {
            "input": {
              "a": -5,
              "b": 0
            },
            "expected_exception": "ZeroDivisionError",
            "expected_message": "Cannot divide by zero"
          }
        ]
      },
      "uncertainty": 0.0,
      "status": "confirmed"
    },
    {
      "id": "calc_power_correct_results",
      "description": "Calculator.power must return the mathematically correct result of base raised to exponent (base ** exponent)",
      "oracle_type": "pytest",
      "oracle_config": {
        "target_module": "src/calculator/core.py",
        "class": "Calculator",
        "method": "power",
        "test_cases": [
          {
            "input": {
              "base": 2,
              "exponent": 3
            },
            "expected": 8
          },
          {
            "input": {
              "base": 5,
              "exponent": 2
            },
            "expected": 25
          },
          {
            "input": {
              "base": 10,
              "exponent": 0
            },
            "expected": 1
          },
          {
            "input": {
              "base": 2,
              "exponent": -1
            },
            "expected": 0.5
          },
          {
            "input": {
              "base": 4,
              "exponent": 0.5
            },
            "expected": 2.0
          },
          {
            "input": {
              "base": -2,
              "exponent": 2
            },
            "expected": 4
          }
        ]
      },
      "uncertainty": 0.1,
      "status": "confirmed"
    },
    {
