{
  "rules": [
    {
      "id": "calc_add_basic",
      "description": "Calculator.add should correctly add two positive numbers, two negative numbers, and a mix of positive and negative. It should also handle zero.",
      "oracle_type": "pytest",
      "oracle_config": {
        "target_module": "src/calculator/core.py",
        "class": "Calculator",
        "method": "add",
        "test_cases": [
          {"a": 2, "b": 3, "expected": 5},
          {"a": -1, "b": -1, "expected": -2},
          {"a": -5, "b": 5, "expected": 0},
          {"a": 0, "b": 0, "expected": 0}
        ]
      },
      "uncertainty": 0.0,
      "status": "confirmed"
    }
  ]
}
